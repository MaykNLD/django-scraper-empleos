# ─────────────────────────────────────────────────────
# Django Scraper Empleos — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# REQUIRED — Django secret key (generate one at https://djecrety.ir)
SECRET_KEY=your-strong-random-secret-key-here

# Development: set to True. Production: must be False (or omit entirely)
DEBUG=True

# Comma-separated list of allowed hosts (production)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — PostgreSQL connection string
# Leave empty to use SQLite (default for local dev)
# DATABASE_URL=postgres://user:password@host:5432/dbname
